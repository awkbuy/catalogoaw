generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String  @id @default(cuid())
  nombre    String  @unique
  icono     String  @default("🎲")
  color     String  @default("#31D3A9")
  tags      String  @default("")
  orden     Int     @default(0)
  games     Game[]  @relation("GameCategories")
  mainGames Game[]  @relation("GameMainCategory")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Game {
  id                 String   @id @default(cuid())
  nombre             String
  slug               String   @unique
  descripcion        String   @default("")
  categoriaId        String
  categoria          Category @relation("GameMainCategory", fields: [categoriaId], references: [id])
  categorias         Category[] @relation("GameCategories")
  jugadoresMin       Int      @default(2)
  jugadoresMax       Int      @default(6)
  duracion           String   @default("60 min")
  edad               String   @default("8+")
  dificultad         String   @default("Normal")
  precioFinalVenta   String   @default("")
  descuento          Int      @default(0)
  precioReservaMesa  String   @default("")
  envioGratis        Boolean  @default(false)
  imagen             String   @default("")
  integrarVideo      Boolean  @default(false)
  videoUrl           String   @default("")
  seoTitle           String   @default("")
  seoDescription     String   @default("")
  seoKeywords        String   @default("")
  canonical          String   @default("")
  imagenAlt          String   @default("")
  descripcionAccesible String @default("")
  resumenIA          String   @default("")
  estado             String   @default("Disponible")
  destacado          Boolean  @default(false)
  nuevo              Boolean  @default(false)
  disponibleVenta    Boolean  @default(false)
  disponibleMesa     Boolean  @default(true)
  orden              Int      @default(0)
  showInMerchant      Boolean  @default(false)
  showInMetaCommerce  Boolean  @default(false)
  allowDynamicAds     Boolean  @default(false)
  marketingFeatured   Boolean  @default(false)
  remarketingEligible Boolean  @default(false)
  googleProductCategory String @default("")
  metaProductCategory    String @default("")
  gtin                 String  @default("")
  mpn                  String  @default("")
  brand                String  @default("Wolfie Room")
  condition            String  @default("new")
  marketingPriority    Int     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
  @@index([categoriaId])
  @@index([orden])
}

model Setting {
  id             String @id @default(cuid())
  key            String @unique
  value          String @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id          String    @id @default(cuid())
  codigo      String    @unique
  tipo        String    @default("porcentaje")
  valor       Int       @default(0)
  minimo      Int       @default(0)
  maximo      Int       @default(0)
  activo      Boolean   @default(true)
  vencimiento DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([codigo])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  titulo      String   @default("")
  descripcion String   @default("")
  icono       String   @default("credit_card")
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  promocional Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orden])
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique
  cost      Int      @default(0)
  freeFrom  Int      @default(0)
  consultar Boolean  @default(false)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model EmailLead {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String   @default("popup")
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  eventType    String
  gameId       String?
  gameName     String?
  categoryId   String?
  categoryName String?
  searchTerm   String?
  source       String?
  price        Float?
  metadata     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([gameId])
  @@index([eventType, createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
}

model DailyMetrics {
  id             String   @id @default(cuid())
  date           DateTime @unique
  uniqueVisitors Int      @default(0)
  sessions       Int      @default(0)
  pageViews      Int      @default(0)
  productViews   Int      @default(0)
  cartAdditions  Int      @default(0)
  whatsappClicks Int      @default(0)
  searches       Int      @default(0)
  checkouts      Int      @default(0)
  topDevice      String?
  topBrowser     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

model ProductMetrics {
  id             String    @id @default(cuid())
  gameId         String    @unique
  gameName       String
  categoryName   String?
  totalViews     Int       @default(0)
  totalCartAdds  Int       @default(0)
  totalWhatsapp  Int       @default(0)
  totalCheckouts Int       @default(0)
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([totalViews(sort: Desc)])
  @@index([totalCartAdds(sort: Desc)])
  @@index([totalWhatsapp(sort: Desc)])
}

model CategoryMetrics {
  id            String   @id @default(cuid())
  categoryId    String   @unique
  categoryName  String
  totalViews    Int      @default(0)
  totalCartAdds Int      @default(0)
  totalWhatsapp Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([totalViews(sort: Desc)])
}

model LandingPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @default("")
  heroTitle       String   @default("")
  heroDescription String   @default("")
  heroImage       String   @default("")
  bannerColor     String   @default("#31D3A9")
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  seoKeywords     String   @default("")
  canonical       String   @default("")
  gameIds         String   @default("[]")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model GA4DailyMetrics {
  id                 String   @id @default(cuid())
  date               DateTime @unique
  users              Int      @default(0)
  newUsers           Int      @default(0)
  sessions           Int      @default(0)
  pageViews          Int      @default(0)
  bounceRate         Float    @default(0)
  avgSessionDuration Float    @default(0)
  deviceDesktop      Int      @default(0)
  deviceMobile       Int      @default(0)
  deviceTablet       Int      @default(0)
  topCountries       String?
  topCities          String?
  topBrowsers        String?
  topOS              String?
  topSources         String?
  topLandingPages    String?
  topEvents          String?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([date])
}
