{
  "name": "wolfie-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio",
    "db:platform:migrate": "npx prisma migrate dev --schema=prisma/platform.prisma",
    "db:platform:generate": "npx prisma generate --schema=prisma/platform.prisma",
    "db:platform:studio": "npx prisma studio --schema=prisma/platform.prisma",
    "admin:reset-password": "npx tsx scripts/reset-admin-password.ts",
    "postinstall": "prisma generate && npx prisma generate --schema=prisma/platform.prisma"
  },
  "prisma": {
    "seed": "node --require ts-node/register prisma/seed.ts"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.1"
  ],
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "motion": "^12.43.0",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "resend": "^6.19.0",
    "sileo": "^0.1.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
