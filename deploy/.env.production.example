# Wolfie Room — entorno de producción (copiar a /var/www/wolfie-room/.env)

# Ruta ABSOLUTA a la base de datos SQLite (evita ambigüedad de rutas relativas)
DATABASE_URL="file:/var/www/wolfie-room/data/dev.db"

# Secreto de sesión aleatorio. Generar con: openssl rand -hex 32
SESSION_SECRET="<generar-al-azar>"

# URL pública del sitio (metadata/SEO/sitemap)
NEXT_PUBLIC_SITE_URL="https://wolfiesroom.com"

# Bind del servidor Node (Nginx proxya a 127.0.0.1:3000)
PORT=3000
HOSTNAME=127.0.0.1

# ─────────────────────────────────────────────────────────────
# Panel admin en ruta secreta (proteger el acceso y sacar el admin
# y el login del índice de Google). Generar con: openssl rand -hex 8
# El acceso pasa de https://wolfiesroom.com/login a
# https://wolfiesroom.com/<ADMIN_PATH>/login. Con el valor vacío
# el panel queda en la ruta pública actual (NO recomendado).
# ─────────────────────────────────────────────────────────────
ADMIN_PATH="<generar-al-azar-p.ej-8f3ab2c9>"

# Resend (email de bienvenida del popup de captura)
# API key en https://resend.com/api-keys · remitente verificado del dominio
RESEND_API_KEY="<generar-en-resend>"
RESEND_FROM="Wolfie Room <no-responder@wolfiesroom.com>"
