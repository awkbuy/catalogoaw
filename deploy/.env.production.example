# Wolfie Room — entorno de producción (copiar a /var/www/wolfie-room/.env)

# Ruta ABSOLUTA a la base de datos SQLite (evita ambigüedad de rutas relativas)
DATABASE_URL="file:/var/www/wolfie-room/data/dev.db"

# Secreto de sesión aleatorio. Generar con: openssl rand -hex 32
SESSION_SECRET="<generar-al-azar>"

# URL pública del sitio (metadata/SEO/sitemap)
NEXT_PUBLIC_SITE_URL="https://wolfiesroom.com"

# Bind del servidor Node (Nginx proxya a 127.0.0.1:3000)
PORT=3000
HOSTNAME=127.0.0.1
