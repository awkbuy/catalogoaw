# Plataforma SaaS — entorno de producción (copiar a /var/www/catalogoaw/.env)

# Ruta ABSOLUTA a la base de datos SQLite global de plataforma
DATABASE_URL="file:/var/www/catalogoaw/data/platform.db"

# Directorio de datos multi-tenant
TENANT_DATA_DIR="/var/www/catalogoaw/data/tenants"

# Secreto de sesión aleatorio. Generar con: openssl rand -hex 32
SESSION_SECRET="<generar-al-azar>"

# URL pública de la plataforma (metadata/SEO/sitemap)
NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# Dominio base para subdominios de tenants (ej. marca.tudominio.com)
PLATFORM_DOMAIN="tudominio.com"

# Instancia standalone de catálogo (sin subdominio de tenant).
# Dejar en "true" cuando la app corre como un solo catálogo (Wolfie Room).
# Requerido en deploy Docker de una sola instancia.
ALLOW_SINGLE_TENANT="true"

# Bind del servidor Node (Caddy proxya a 127.0.0.1:3000)
PORT=3000
HOSTNAME=127.0.0.1

# ─────────────────────────────────────────────────────────────
# Panel superadmin en ruta secreta. Generar con: openssl rand -hex 8
# ─────────────────────────────────────────────────────────────
ADMIN_PATH="<generar-al-azar-p.ej-8f3ab2c9>"

# Resend (email transaccional: welcome, changelog, recordatorios)
RESEND_API_KEY="<generar-en-resend>"
RESEND_FROM="Plataforma <no-responder@tudominio.com>"

# Mercado Pago (suscripciones SaaS) — Fase 5
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
